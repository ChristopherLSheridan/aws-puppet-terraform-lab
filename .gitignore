# Terraform state (may contain sensitive information)
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info

# Terraform variable files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plan files
*.tfplan
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials and private keys
.aws/
*.pem
*.key
*.p12

# Puppet sensitive files
puppet/ssl/
puppet/environments/*/private/

# Local environment files
.env
.env.*
!.env.example

# Editor files
.vscode/
.idea/
*.swp
*~
